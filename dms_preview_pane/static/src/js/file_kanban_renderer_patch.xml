<templates xml:space="preserve">
    <!--
        Split-layout wrapper around the dms kanban renderer. t-calls the
        original `dms.KanbanRenderer` so this stays a pure extension. Same edge
        chevron toggle as the list split.
    -->
    <t t-name="dms_preview_pane.KanbanRenderer">
        <div
            class="o_dms_split o_dms_kanban_split"
            t-att-data-preview-open="previewState.open ? 'true' : 'false'"
        >
            <div class="o_dms_split__main">
                <t t-call="dms.KanbanRenderer" />
            </div>
            <div class="o_dms_preview_toggle_wrapper">
                <button
                    type="button"
                    class="o_dms_preview_toggle_btn btn"
                    t-att-aria-label="previewState.open ? 'Hide preview pane' : 'Show preview pane'"
                    t-att-aria-pressed="previewState.open ? 'true' : 'false'"
                    t-att-title="previewState.open ? 'Hide preview (Esc)' : 'Show preview'"
                    t-on-click.prevent="() => this.togglePreview()"
                >
                    <i
                        t-attf-class="fa {{ previewState.open ? 'fa-angle-right' : 'fa-angle-left' }}"
                    />
                </button>
            </div>
            <FilePreviewPane
                t-if="previewState.open"
                recordId="previewState.recordId"
                reloadToken="previewState.reloadToken"
                onClose="() => this.closePreview()"
            />
        </div>
    </t>
</templates>
