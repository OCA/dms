<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">Configure dms file display name</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="dms.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[1]" position="inside">
                <setting string="File Display Name">
                    <field name="dms_file_display_name_pattern" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
