<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="dms_list.Renderer">
        <div class="dms_treeview">
            <div class="container-fluid dms_document_container">
                <div class="row o_dms_header">
                    <div
                        class="o_dms_extra_actions btn-group flex-wrap w-auto p-0"
                        role="toolbar"
                        aria-label="Actions"
                    >
                        <button
                            t-if="this.state.hasEmptyStorages"
                            type="button"
                            class="btn btn-secondary o_dms_add_directory"
                            title="Create the directories of this record"
                            t-on-click="this.onDMSAddDirectoryRecord"
                        >
                            <i class="oi oi-fw" data-icon="database" />
                        </button>
                        <t
                            t-foreach="this.selectedActions"
                            t-as="action"
                            t-key="action.key"
                        >
                            <button
                                type="button"
                                class="btn btn-secondary"
                                t-att-class="'o_dms_action_' + action.key"
                                t-att-title="action.label"
                                t-att-aria-label="action.label"
                                t-att-disabled="action.disabled"
                                t-on-click="() => this.onClickAction(action)"
                            >
                                <i class="oi oi-fw" t-att-data-icon="action.icon" />
                            </button>
                        </t>
                    </div>
                </div>
                <div
                    t-attf-class="row dms_document_row #{this.ui.isSmall ? 'dms_document_mobile' : 'dms_document_desktop'}"
                >
                    <div class="dms_document_col dms_document_col_tree">
                        <div class="dms_document_tree">
                            <div class="dms_content">
                                <DmsTree
                                    model="this.tree"
                                    onContextMenu="(node, target) => this.openContextMenu(node, target)"
                                    onAction="(key, node) => this.runNodeAction(key, node)"
                                />
                            </div>
                        </div>
                    </div>
                    <div
                        class="dms_document_col dms_document_col_preview"
                        t-ref="this.dropZone"
                    >
                        <div class="dms_document_preview">
                            <t t-call="dms_list.DocumentTreeViewDirectoryPreview" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
    <t t-name="dms_list.DocumentTreeViewDirectoryPreview">
        <t t-set="selected" t-value="this.state.selected" />
        <div
            class="o_preview_directory"
            t-if="selected.resModel"
            t-att-data-directory-id="selected.resModel === 'dms.directory' ? selected.data.id : ''"
        >
            <div class="top_info row">
                <div class="left_info col-4">
                    <div class="o_preview_directory_icon text-center">
                        <img
                            t-if="selected.resModel === 'dms.directory'"
                            class="h-100 w-100"
                            t-att-src="selected.data.icon_url"
                            alt=""
                        />
                        <a
                            t-if="selected.resModel === 'dms.file'"
                            class="o_preview_file"
                            href="#"
                            t-on-click.prevent="() => this.onDMSPreviewFile(this.selectedNode)"
                        >
                            <img
                                class="h-100 w-100"
                                t-att-src="selected.data.icon_url"
                                alt=""
                            />
                        </a>
                    </div>
                </div>
                <div class="right_info col-8 pe-3">
                    <h3 class="text-break">
                        <t t-out="selected.data.name" />
                    </h3>
                    <t t-if="selected.resModel === 'dms.directory'">
                        <p>
                            <b>Subdirectories:</b>
                            <span t-out="selected.data.count_total_directories" />
                        </p>
                        <p>
                            <b>Files:</b>
                            <span t-out="selected.data.count_total_files" />
                        </p>
                        <p>
                            <b>Size:</b>
                            <span
                                t-if="selected.data.human_size"
                                t-out="selected.data.human_size"
                            />
                        </p>
                        <p>
                            <b>Elements:</b>
                            <span t-out="selected.data.count_elements" />
                        </p>
                    </t>
                    <t t-if="selected.resModel === 'dms.file'">
                        <p>
                            <b>Size:</b>
                            <span t-out="selected.data.human_size" />
                        </p>
                        <div class="bottom_buttons d-flex gap-1">
                            <a
                                class="btn btn-primary"
                                t-attf-href="/web/content?id={{ selected.data.id }}&amp;field=content&amp;model=dms.file&amp;filename_field=name&amp;download=true"
                            >
                                <i class="oi oi-fw" data-icon="download" />
                                Download
                            </a>
                            <button
                                type="button"
                                class="btn btn-primary o_preview_file"
                                t-on-click="() => this.onDMSPreviewFile(this.selectedNode)"
                            >
                                Open
                            </button>
                        </div>
                    </t>
                </div>
            </div>
        </div>
    </t>
</templates>
