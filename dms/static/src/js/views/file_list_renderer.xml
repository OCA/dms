<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="dms.ListRenderer" t-inherit="web.ListRenderer" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_list_renderer')]" position="before">
            <div t-if="this.dragState.showDragZone" class="o_dropzone">
                <i class="oi oi-10x" data-icon="cloud_upload" />
            </div>
        </xpath>
    </t>

    <t
        t-name="dms.ListButtons"
        t-inherit="web.ListView.Buttons"
        t-inherit-mode="primary"
    >
        <xpath expr="." position="inside">
            <button
                type="button"
                class="d-none d-md-inline o_button_upload_expense btn btn-primary mx-1"
                t-on-click.prevent="this.uploadDocument"
            >
                Upload
            </button>
        </xpath>

        <xpath expr="." position="inside">
            <button
                type="button"
                class="d-inline d-md-none o_button_upload_expense btn btn-primary mx-1"
                t-on-click.prevent="this.uploadDocument"
            >
                Scan
            </button>
        </xpath>

        <xpath expr="." position="inside">
            <input
                type="file"
                name="ufile"
                class="d-none"
                t-ref="this.fileInput"
                multiple="1"
                accept="*"
                t-on-change="this.onChangeFileInput"
            />
        </xpath>
    </t>
</templates>
