<templates xml:space="preserve">
    <t
        t-name="dms.KanbanRendererBase"
        t-inherit="web.KanbanRenderer"
        t-inherit-mode="primary"
    >
        <xpath expr="//div[hasclass('o_kanban_renderer')]" position="before">
            <div t-if="dragState.showDragZone" class="o_dropzone o_dms_dropzone">
                <div class="o_dms_dropzone__icon">
                    <i class="fa fa-cloud-upload" />
                </div>
                <div class="o_dms_dropzone__title">Drop files to upload</div>
                <div class="o_dms_dropzone__hint">
                    Release to add to the current directory
                </div>
            </div>
            <div
                class="o_kanban_dms_density_toggle btn-group btn-group-sm"
                role="group"
                aria-label="Card density"
            >
                <button
                    type="button"
                    t-foreach="densityOptions"
                    t-as="opt"
                    t-key="opt.value"
                    t-att-class="{
                        'btn': true,
                        'btn-secondary': density === opt.value,
                        'btn-outline-secondary': density !== opt.value,
                    }"
                    t-att-title="opt.label"
                    t-att-aria-pressed="density === opt.value"
                    t-on-click="() => this.setDensity(opt.value)"
                >
                    <i t-attf-class="fa #{opt.icon}" />
                </button>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('o_kanban_renderer')]" position="attributes">
            <attribute name="t-att-data-density">density</attribute>
        </xpath>
    </t>

    <t t-name="dms.KanbanRenderer">
        <div
            class="o_dms_kanban_split"
            t-att-data-preview-open="previewState.open ? 'true' : 'false'"
        >
            <div class="o_dms_kanban_split__main">
                <t t-call="dms.KanbanRendererBase" />
            </div>
            <FilePreviewPane
                t-if="previewState.open"
                recordId="previewState.recordId"
                onClose="() => this.closePreview()"
            />
            <button
                type="button"
                class="o_dms_kanban_split__toggle btn btn-sm d-flex align-items-center gap-1"
                t-att-class="{
                    'o_dms_kanban_split__toggle--on': previewState.open,
                    'o_dms_kanban_split__toggle--off': !previewState.open,
                }"
                t-att-title="previewState.open ? 'Hide preview pane (Esc)' : 'Show side-by-side preview'"
                t-att-aria-pressed="previewState.open"
                t-on-click="() => this.togglePreview()"
            >
                <i t-attf-class="fa #{previewState.open ? 'fa-times' : 'fa-columns'}" />
                <span class="d-none d-md-inline">
                    <t t-if="previewState.open">Hide preview</t>
                    <t t-else="">Preview pane</t>
                </span>
            </button>
        </div>
    </t>

    <t t-name="dms.KanbanButtons">
        <div
            class="o_cp_buttons d-empty-none d-flex align-items-baseline gap-1"
            role="toolbar"
            aria-label="DMS file actions"
        >
            <t t-if="props.archInfo.activeActions.create">
                <button
                    type="button"
                    class="d-inline d-md-none btn btn-primary mx-1"
                    t-on-click.prevent="uploadDocument"
                >
                    Scan
                </button>
                <input
                    type="file"
                    name="ufile"
                    class="d-none"
                    t-ref="fileInput"
                    multiple="1"
                    accept="*"
                    t-on-change="onChangeFileInput"
                />
                <button
                    type="button"
                    class="d-none d-md-inline btn btn-primary mx-1"
                    t-on-click.prevent="uploadDocument"
                >
                    Upload
                </button>
            </t>
        </div>
    </t>
</templates>
