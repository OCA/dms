<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_dms_spreadsheet_create_form" model="ir.ui.view">
        <field name="name">dms.spreadsheet.create.form</field>
        <field name="model">dms.spreadsheet.create</field>
        <field name="arch" type="xml">
            <form string="New Spreadsheet">
                <group>
                    <field name="name" autofocus="1" />
                    <field name="directory_id" />
                </group>
                <footer>
                    <button
                        name="action_create_spreadsheet"
                        string="Create &amp; Open"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dms_spreadsheet_create" model="ir.actions.act_window">
        <field name="name">New Spreadsheet</field>
        <field name="res_model">dms.spreadsheet.create</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_directory_id': active_id}</field>
    </record>
</odoo>
